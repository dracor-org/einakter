    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/swc-plugin": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
