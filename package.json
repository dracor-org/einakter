    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "xmlbuilder": "^15.1.1"
  },
  "scripts": {
    "csv": "ts-node -O '{\"isolatedModules\":false,\"module\":\"CommonJS\"}' yml2csv.ts && cp ./data.csv ./public/",
    "json": "ts-node -O '{\"isolatedModules\":false,\"module\":\"CommonJS\"}' yml2json.ts && cp ./data.json ./src/ && cp ./data.json ./public/",
    "beacon": "ts-node -O '{\"isolatedModules\":false,\"module\":\"CommonJS\"}' yml2beacon.ts",
    "mixnmatch": "ts-node -O '{\"isolatedModules\":false,\"module\":\"CommonJS\"}' yml2mixnmatch.ts",
    "authors": "ts-node -O '{\"isolatedModules\":false,\"module\":\"CommonJS\"}' fetch-authors.ts",
    "locations": "ts-node -O '{\"isolatedModules\":false,\"module\":\"CommonJS\"}' fetch-locations.ts",
    "start": "pnpm run csv && pnpm run json && vite",
    "build": "pnpm run csv && pnpm run json && pnpm run beacon && pnpm run mixnmatch && vite build",
    "test": "pnpm run compile && pnpm run csv && pnpm run json && vitest",
    "lint": "eslint src",
    "extract": "lingui extract",
    "compile": "lingui compile --typescript"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "parserOptions": {
      "babelOptions": {
        "presets": [
          [
            "babel-preset-react-app",
            false
          ],
          "babel-preset-react-app/prod"
        ]
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "pnpm@11.17.0"
}
